{
  "name": "mindlex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:migration:generate": "npm run typeorm -- migration:generate ./src/migrations/Migration -d ./src/lib/database.ts",
    "db:migration:run": "npm run typeorm -- migration:run -d ./src/lib/database.ts",
    "db:migration:revert": "npm run typeorm -- migration:revert -d ./src/lib/database.ts",
    "db:migration:create": "npm run typeorm -- migration:create ./src/migrations/Migration",
    "db:schema:sync": "npm run typeorm -- schema:sync -d ./src/lib/database.ts",
    "db:schema:drop": "npm run typeorm -- schema:drop -d ./src/lib/database.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@auth/typeorm-adapter": "^2.10.0",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.4.5",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "mdx-mermaid": "^2.0.3",
    "mermaid": "^11.9.0",
    "next": "15.3.4",
    "next-auth": "^5.0.0-beta.29",
    "openai": "^5.8.2",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.59.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "typeorm": "^0.3.25",
    "zod": "^4.0.17",
    "framer-motion": "^12.23.12"
